{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0xHoneyJar/loa-straylight/.straylight/schemas/lane-v1.schema.json",
  "title": "Straylight Control Plane lane record (v1)",
  "description": "Reduced lane state. Published contract; the executable validator is .straylight/lib/validate.mjs#validateLane. GitHub issues identify lanes; this record is derived by reducing the lane's append-only event record.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "lane_id",
    "phase",
    "authorized_corridor",
    "repository",
    "base_branch",
    "base_sha",
    "tier",
    "authority_bearing",
    "state",
    "next_actor",
    "attempt",
    "patch_cycle",
    "mode",
    "auto_merge_allowed",
    "operator_pause",
    "event_sequence"
  ],
  "properties": {
    "schema": { "const": "straylight.lane.v1" },
    "lane_id": { "type": "string", "pattern": "^lane-[a-z0-9][a-z0-9-]{1,62}$" },
    "phase": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "authorized_corridor": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" }
    },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "base_branch": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,200}$" },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "tier": { "enum": ["tier-0", "tier-1", "tier-2", "tier-3"] },
    "authority_bearing": { "type": "boolean" },
    "state": {
      "enum": [
        "planning",
        "ready-for-coordinator",
        "ready-for-claude",
        "claude-working",
        "ready-for-codex",
        "codex-working",
        "ready-for-merge",
        "merged",
        "patch-required",
        "blocked",
        "operator-required",
        "lease-expired",
        "superseded"
      ]
    },
    "next_actor": { "enum": ["coordinator", "implementer", "auditor", "operator", "system", "none"] },
    "working_branch": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._/-]{1,200}$" },
    "pr_number": { "type": ["integer", "null"], "minimum": 1 },
    "pr_head_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "audited_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "verdict": { "enum": ["ACCEPT", "PATCH", "REJECT", "CANNOT_AUDIT", null] },
    "attempt": { "type": "integer", "minimum": 0 },
    "patch_cycle": { "type": "integer", "minimum": 0 },
    "audit_retry": {
      "type": "integer",
      "minimum": 0,
      "description": "Consecutive retryable CANNOT_AUDIT requeues; capped at 3, reset by implementer.completed."
    },
    "mode": {
      "const": "shadow",
      "description": "Control Plane v1 permits shadow mode only. The validator rejects 'active'."
    },
    "auto_merge_allowed": {
      "const": false,
      "description": "Control Plane v1 forbids automatic merge. The validator rejects true."
    },
    "operator_pause": { "type": "boolean" },
    "operator_required_reason": { "type": ["string", "null"] },
    "lease": {
      "type": ["object", "null"],
      "required": ["lane_id", "actor_role", "lease_id", "grant_sequence", "acquired_at", "expires_at", "expected_state"],
      "properties": {
        "lane_id": { "type": "string", "pattern": "^lane-[a-z0-9][a-z0-9-]{1,62}$" },
        "actor_role": { "enum": ["implementer", "auditor"] },
        "lease_id": { "type": "string", "pattern": "^lease-[a-z0-9][a-z0-9-]{1,62}$" },
        "grant_sequence": { "type": "integer", "minimum": 1 },
        "acquired_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "expected_state": { "type": "string" }
      }
    },
    "event_sequence": { "type": "integer", "minimum": 0 },
    "last_transition": { "type": ["string", "null"] }
  }
}
