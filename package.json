{
  "name": "@loa/straylight",
  "version": "0.0.1",
  "private": true,
  "description": "Straylight Recall Wedge MVP — governed recall over a signed actor estate (local, in-repo).",
  "type": "module",
  "types": "./dist-types/src/straylight/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/src/straylight/index.d.ts"
    },
    "./host": {
      "types": "./dist-types/src/straylight/host/index.d.ts"
    },
    "./runtime/recall-intake": {
      "types": "./dist-types/src/straylight/runtime/recall-intake/index.d.ts",
      "import": "./dist/src/straylight/runtime/recall-intake/index.js"
    }
  },
  "files": [
    "dist-types/",
    "dist/",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean:types": "node -e \"require('node:fs').rmSync('dist-types', { recursive: true, force: true })\"",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean:types && npm run clean:dist && tsc -p tsconfig.build.json && tsc -p tsconfig.runtime.json && node scripts/prune-dist-runtime.mjs",
    "postbuild": "node scripts/phase-50a/prune-internal-postgres-types.mjs",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:recall": "vite-node scripts/demo-recall-wedge.ts",
    "demo:recall:json": "vite-node scripts/demo-recall-wedge.ts -- --json --out=.run/recall-demo.json",
    "demo:recall-wedge": "vite-node scripts/demo-recall-wedge-31f.ts",
    "schema:candidates": "vite-node scripts/export-schema-candidates.ts",
    "hounfour:conformance": "vite-node scripts/export-hounfour-conformance.ts",
    "hounfour:handoff": "vite-node scripts/print-hounfour-handoff-summary.ts",
    "finn:enforcement": "vite-node scripts/export-finn-enforcement-fixtures.ts",
    "dixie:recall": "vite-node scripts/export-dixie-governed-recall-fixtures.ts",
    "freeside:surface": "vite-node scripts/export-freeside-community-surface-fixtures.ts",
    "handoffs:index": "vite-node scripts/print-cross-repo-handoff-index.ts",
    "hounfour:rc-readiness": "vite-node scripts/print-hounfour-rc-readiness.ts",
    "hounfour:shadow-inspect": "vite-node scripts/inspect-hounfour-shadow.ts",
    "control-plane:validate": "node .straylight/bin/validate-protocol.mjs",
    "control-plane:test": "vitest run tests/control-plane",
    "phase-50a:up": "docker compose -f docker-compose.phase-50a.yml up -d --wait",
    "phase-50a:down": "docker compose -f docker-compose.phase-50a.yml down -v",
    "phase-50a:test": "node scripts/phase-50a/run-postgres-suites.mjs",
    "phase-50a:proof": "node scripts/phase-50a/run-two-host-proof.mjs",
    "phase-50a:verify-artifact": "node scripts/phase-50a/verify-generated-artifact.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.20.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@0xhoneyjar/loa-hounfour": "8.7.0",
    "pg": "^8.22.0"
  }
}
